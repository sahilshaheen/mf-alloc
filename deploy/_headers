/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; style-src-attr 'unsafe-inline'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/exposure-*.json
  Cache-Control: public, max-age=31536000, immutable

/data/manifest.json
  Cache-Control: no-cache
